<% if @author.errors.any? %>
  <h3>The author could not be saved because of the following errors:</h2>
  <ul>
    <% @author.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @author do |f| %>
  <p>
    <strong><%= f.label :name%></strong><br/>
    <%= f.text_field :name%>
  </p>

  <p><%= f.submit %></p>
<% end %>
