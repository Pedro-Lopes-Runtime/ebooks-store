<h1>Show Ebook</h1>

<div>
  <% if @ebook.cover.representable? %>
    <p>
      <%= image_tag @ebook.cover.representation(resize_to_limit: [300, 300]) %>
    </p>
  <% end %>
	<p>
    <strong>Name: </strong>
    <%= @ebook.title %>
  </p>
	<p>
    <strong>Description: </strong>
    <%= @ebook.description %>
  </p>
	<p>
    <strong>Author: </strong>
    <%= link_to @ebook.author.name, @ebook.author %>
  </p>
	<p>
    <strong>Price: </strong>
    <%= @ebook.price.present? ? @ebook.price : "Free" %>
  </p>
	<p>
    <strong>Status: </strong>
    <%= @ebook.ebook_status.name %>
  </p>
  <% if @ebook.preview.representable? %>
    <p>
      <strong>Preview: </strong><br/>
      <%= image_tag @ebook.preview.representation(resize_to_limit: [300, 300]) %>
    </p>
  <% end %>
  <% if @ebook.preview.present? %>
    <%= link_to "Preview", preview_ebook_path(@ebook.id) %>
  <% end %>

  <p>
    <%= button_to "Buy", purchase_ebook_path(@ebook.id) %>
  </p>

  <p><%= link_to 'Return to ebook listing', ebooks_path %></p>
</div>