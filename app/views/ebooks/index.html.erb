<h1>Listing all Ebooks</h1>

<div>
	<table>
		<thead>
			<tr>
				<th>Title</th>
				<th>Description</th>
				<th>Author</th>
				<th>Status</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			<% @ebooks.each do |ebook|%>
			<tr>
				<td><%= link_to ebook.title, ebook %></td>
				<td><%= ebook.description %></td>
				<td><%= ebook.author.name %></td>
				<td><%= ebook.ebook_status.name %></td>
				<% if ebook.ebook_status.name != 'Live' %>
					<td><%= link_to 'Advance status', update_status_ebook_path(ebook.id),
									data: {turbo_method: :post } %></td>
				<% end %>
				<td><%= link_to 'Edit', edit_ebook_path(ebook.id) %></td>
				<td><%= link_to 'Delete', ebook_path(ebook.id), 
								data: {turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this Ebook?'} %></td>
			</tr>
			<% end %>
		</tbody>
	</table>

	<p><%= link_to 'Create Ebook', new_ebook_path %></p>
</div>