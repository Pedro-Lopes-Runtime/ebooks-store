<h1>Listing all Ebooks</h1>

<%= form_tag ebooks_path, method: :get %>
  <p>
    <strong><%= label_tag "Pesquisa" %></strong><br/>
    <%= text_field_tag :query, params[:query] || "" %>
  </p>
  <p>
    <strong><%= label_tag :tag %></strong><br/>
    <%= select_tag :tag, options_from_collection_for_select(Tag.all, :id, :name, params[:tag]), include_blank: true %>
  </p>
  <p>
    <strong><%= label_tag :user %></strong><br/>
    <%= select_tag :user, options_for_select(@sellers, params[:user]), include_blank: true %>
  </p>
  <p>
    <strong><%= label_tag :author %></strong><br/>
    <%= select_tag :author, options_from_collection_for_select(Author.all, :id, :name, params[:author]), include_blank: true %>
  </p>

  <p><%= submit_tag "Procurar"%></p>

<div>
	<table class="table">
		<thead>
			<tr>
				<th class="col">Title</th>
				<th class="col">Description</th>
				<th class="col">Author</th>
				<th class="col">Status</th>
				<th class="col">Actions</th>
			</tr>
		</thead>
		<tbody>
			<% @ebooks.each do |ebook|%>
			<tr>
				<td><%= link_to ebook.title, ebook %></td>
				<td><%= ebook.description %></td>
				<td><%= link_to ebook.author.name, author_path(ebook.author.id) %></td>
				<td><%= ebook.status %></td>
				<% if ebook.status != 'Live' %>
					<td><%= link_to 'Advance status', update_status_ebook_path(ebook.id),
									data: {turbo_method: :post } %></td>
				<% end %>
				<td><%= link_to 'Edit', edit_ebook_path(ebook.id) %></td>
				<td><%= link_to 'Delete', ebook_path(ebook.id), 
								data: {turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this Ebook?'} %></td>
			</tr>
			<% end %>
		</tbody>
	</table>

	<%= will_paginate @ebooks %>

	<p><%= link_to 'Create Ebook', new_ebook_path %></p>
</div>