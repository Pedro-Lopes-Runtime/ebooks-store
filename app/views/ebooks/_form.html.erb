<% if @ebook.errors.any? %>
  <h3>The ebook could not be saved because of the following errors:</h3>
  <ul>
    <% @ebook.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @ebook do |f| %>
  <p>
    <strong><%= f.label :title%></strong><br/>
    <%= f.text_field :title%>
  </p>
  <p>
    <strong><%= f.label :description%></strong><br/>
    <%= f.text_area :description%>
  </p>
  <p>
    <strong><%= f.label :author%></strong><br/>
    <%= f.select :author_id, Author.all.pluck(:name, :id)%>
  </p>
  <p>
    <strong><%= f.label :price%></strong><br/>
    <%= f.number_field :price, step: "0.01"%>
  </p>
  <p>
    <strong><%= f.label :seller%></strong><br/>
    <%= f.select :seller_id, Seller.all.map(&:user).pluck(:displayname, :id) %>
  </p>
  <p>
    <strong><%= f.label :status%></strong><br/>
    <%= f.select :ebook_status_id, EbookStatus.all.pluck(:name, :id)%>
  </p>
  <p>
    <strong><%= f.label :preview%></strong><br/>
    <%= f.file_field :preview %>
  </p>
  <p>
    <strong><%= f.label :cover%></strong><br/>
    <%= f.file_field :cover %>
  </p>

  <p><%= f.submit %></p>
<% end %>
