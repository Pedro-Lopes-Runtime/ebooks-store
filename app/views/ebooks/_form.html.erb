<% if @ebook.errors.any? %>
  <h3>The ebook could not be saved because of the following errors:</h2>
  <ul>
    <% @ebook.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @ebook do |f| %>
  <p>
    <strong><%= f.label :title%></strong><br/>
    <%= f.text_field :title%>
  </p>
  <p>
    <strong><%= f.label :description%></strong><br/>
    <%= f.text_area :description%>
  </p>
  <p>
    <strong><%= f.label :author%></strong><br/>
    <%= f.select :author_id, Author.all.pluck(:name, :id)%>
  </p>

  <p><%= f.submit %></p>
<% end %>
