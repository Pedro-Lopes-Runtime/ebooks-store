<% if @user.errors.any? %>
  <h3>The user could not be saved because of the following errors:</h3>
  <ul>
    <% @user.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user do |f| %>
  <p>
    <strong><%= f.label :username%></strong><br/>
    <%= f.text_field :username%>
  </p>
  <p>
    <strong><%= f.label :displayname%></strong><br/>
    <%= f.text_area :displayname%>
  </p>
  <p>
    <strong><%= f.label :email%></strong><br/>
    <%= f.text_area :email%>
  </p>
  <% if action_name == "new" %>
      <%= f.hidden_field :status, value: true %>
      <p>
        <strong><%= f.label :profileable_type%></strong><br/>
        <%= f.select :profileable_type, ['Seller', 'Buyer']%>
      </p>
  <% end %>
  <p>
    <strong><%= f.label :profile_image%></strong><br/>
    <%= f.file_field :profile_image %>
  </p>

  <p><%= f.submit %></p>
<% end %>
