<h1>Listing all Users</h1>

<div>
	<table class="table">
		<thead>
			<tr>
				<th class="col">Username</th>
				<th class="col">Email</th>
				<th class="col">Status</th>
				<th class="col">Type</th>
				<th class="col">Actions</th>
			</tr>
		</thead>
		<tbody>
			<% @users.each do |user|%>
			<tr>
				<td><%= link_to user.username, user %></td>
				<td><%= user.email %></td>
				<td><%= user.status %></td>
				<td><%= user.profileable_type %></td>
				<td><%= link_to user.status ? 'Disable' : 'Enable', update_status_user_path(user.id),
								data: {turbo_method: :post } %></td>
				<td><%= link_to 'Edit', edit_user_path(user.id) %></td>
				<td><%= link_to 'Delete', user_path(user.id), 
								data: {turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this User?'} %></td>
			</tr>
			<% end %>
		</tbody>
	</table>
</div>