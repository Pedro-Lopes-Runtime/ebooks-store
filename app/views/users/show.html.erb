<div class="container rounded bg-white mt-5 mb-5">
  <div class="row">
    <div class="col-md-4 border-right">
      <div class="d-flex flex-column align-items-center text-center p-3 py-5">
        <% if @user.profile_image.representable? %>
          <p>
            <%= image_tag @user.profile_image.representation(resize_to_limit: [250, 250]), class: "rounded-circle mt-5" %>
          </p>
        <%else%>
          <%= image_tag "profile_placeholder.png", width: 250, class: "rounded-circle mt-5" %>
        <% end %>
        <span class="font-weight-bold"><%= @user.displayname %></span>
        <span class="text-black-50"><%= @user.email %></span><span> </span>
      </div>
    </div>
    <div class="col-md-8 border-right">
      <div class="p-3 py-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="text-right">User Profile</h4>
        </div>
        <div class="row mt-3">
          <div class="col-md-12"><strong>Username</strong><p><%= @user.username %></p></div>
          <div class="col-md-12"><strong>Status</strong><p><%= @user.status %></p></div>
          <div class="col-md-12"><strong>User type</strong><p><%= @user.profileable_type %></p></div>
        </div>
        <div class="mt-3"><%= button_to 'Return to user listing', users_path, method: :get, class: "btn btn-secondary" %></div>
      </div>
    </div>
  </div>
</div>